# 從 https://developers.henrikdev.xyz/ 免費申請
HENRIK_API_KEY=HDEV-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# session 加密金鑰，自己隨機產生一個長字串，千萬不要公開
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-secret

# 部署環境設為 production，本機開發留空即可
# NODE_ENV=production

# 伺服器 port（可選，預設 3000）
PORT=3000

# AI 教練點評用的 Gemini 金鑰（可選）
# 從 https://aistudio.google.com 免費申請；不填則教練功能自動隱藏，其他功能正常
# GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxx

# 持久化開關（可選）：設為掛載 Volume 的路徑後，session 與商店歷史重啟後不消失
# DATA_DIR=/data
